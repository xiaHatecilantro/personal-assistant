# 部署环境变量
# 复制为 .env 并填入实际值

# 数据库 root 密码（必需）
DB_PASSWORD=changeme

# JWT 签名密钥（必需，建议用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_EXPIRE_MINUTES=10080

# 生产环境会拒绝使用上面的默认 JWT 密钥
APP_ENV=development

# 浏览器允许访问 API 的来源，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 后端文件浏览 API 可访问的根目录；Windows 多目录使用分号分隔
# FILE_ALLOWED_ROOTS=D:\personal_project

# 服务端允许代理访问的 OpenAI 兼容 API 地址，多个地址用逗号分隔
LLM_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.openai.com/v1
