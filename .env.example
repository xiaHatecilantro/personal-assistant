# 部署环境变量
# 复制为 .env 并填入实际值

# 数据库 root 密码（必需）
DB_PASSWORD=changeme

# LangGraph Checkpoint PostgreSQL 密码（必需，供 PostgreSQL 容器使用）
CHECKPOINT_DB_PASSWORD=changeme

# 后端容器连接 Checkpoint 数据库的完整地址；密码中的保留字符需要 URL 编码，
# 并与上面的原始 CHECKPOINT_DB_PASSWORD 保持一致
CHECKPOINT_DATABASE_URL=postgresql://agent:changeme@agent-checkpoint-db:5432/agent_checkpoints

# JWT 签名密钥（必需，建议用 openssl rand -hex 32 生成）
# Compose 固定 production；必须生成自己的强随机密钥，空值会在配置检查时失败。
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080

# 生产环境会拒绝使用上面的默认 JWT 密钥
APP_ENV=production

# 浏览器允许访问 API 的来源，多个来源用逗号分隔
CORS_ORIGINS=http://localhost,http://127.0.0.1

# 后端文件浏览 API 可访问的根目录；Windows 多目录使用分号分隔
# FILE_ALLOWED_ROOTS=D:\personal_project

# 服务端允许代理访问的 OpenAI 兼容 API 地址，多个地址用逗号分隔
LLM_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.openai.com/v1

# Agent 模型凭据只保存在后端，不由前端传入
AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL_NAME=deepseek-chat
AGENT_MODEL_API_KEY=

# 单次运行的安全预算
AGENT_MAX_STEPS=12
AGENT_RUN_TIMEOUT_SECONDS=300
