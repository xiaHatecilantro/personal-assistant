APP_ENV=development
DATABASE_URL=mysql+pymysql://root:changeme@localhost:3307/personal_assistant?charset=utf8mb4&ssl_disabled=true
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FILE_ALLOWED_ROOTS=D:\personal_project
LLM_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.openai.com/v1

# LangGraph Checkpoint 使用独立 PostgreSQL；本地映射端口为 5433
CHECKPOINT_DATABASE_URL=postgresql://agent:changeme@127.0.0.1:5433/agent_checkpoints

# Agent 模型凭据由后端持有，不由前端请求传入
AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL_NAME=deepseek-chat
AGENT_MODEL_API_KEY=

# 单次 Agent Run 的执行预算
AGENT_MAX_STEPS=12
AGENT_RUN_TIMEOUT_SECONDS=300
